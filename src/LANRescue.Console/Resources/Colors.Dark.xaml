                     Color="{StaticResource WarningSurfaceColor}"/>
    <SolidColorBrush x:Key="WarningBorderBrush"
                     Color="{StaticResource WarningBorderColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush"
                     Color="{StaticResource WarningTextColor}"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush"
                     Color="{StaticResource DangerSurfaceColor}"/>
    <SolidColorBrush x:Key="DangerBorderBrush"
