    <SolidColorBrush x:Key="TableAlternateBrush"
                     Color="{StaticResource TableAlternateColor}"/>
    <SolidColorBrush x:Key="TableHoverBrush"
                     Color="{StaticResource TableHoverColor}"/>
    <SolidColorBrush x:Key="TableSelectedBrush"
                     Color="{StaticResource TableSelectedColor}"/>
    <SolidColorBrush x:Key="TableGridLineBrush"
                     Color="{StaticResource TableGridLineColor}"/>
