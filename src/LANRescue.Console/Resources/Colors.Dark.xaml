<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fresh Fluent – Bright Blue / Sky Glass palette. Keep colors centralized here. -->
    <Color x:Key="AppBackgroundColor">#FF0F1B2D</Color>
    <Color x:Key="SidebarColor">#E614243A</Color>
