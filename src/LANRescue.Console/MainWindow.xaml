<Window x:Class="LANRescue.ConsoleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN Rescue"
        Height="860"
        Width="1440"
        MinHeight="700"
        MinWidth="860"
        WindowState="Maximized"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="RootLayoutGrid"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn"
                              Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,1,0">
            <DockPanel x:Name="SidebarDockPanel"
                       Margin="20,22">
                <StackPanel DockPanel.Dock="Top"
                            Margin="5,0,5,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="{DynamicResource PrimaryButtonBrush}"
                                VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBrandGeometry}"
                                  Stroke="{DynamicResource PrimaryButtonForegroundBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="20"
                                  Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="SidebarBrandText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource App_Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource Shell_BrandSubtitle}"
                                       Foreground="{DynamicResource SidebarMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1"
                            Background="{DynamicResource BorderBrushSoft}"
                            Margin="0,20,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="WorkspaceSectionLabel"
                               Text="{DynamicResource Shell_Workspace}"
                               Foreground="{DynamicResource SidebarMutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="10,0,0,8"/>
                    <Button x:Name="DashboardNavButton"
                            AutomationProperties.Name="{DynamicResource Nav_Dashboard}"
                            ToolTip="{DynamicResource Tooltip_Dashboard}"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDashboardGeometry}"
                                  Style="{StaticResource NavigationIconPathStyle}"
                                  Margin="0,0,12,0"/>
                            <TextBlock x:Name="DashboardNavLabel"
                                       Text="{DynamicResource Nav_Dashboard}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DevicesNavButton"
                            AutomationProperties.Name="{DynamicResource Nav_Devices}"
                            ToolTip="{DynamicResource Tooltip_Devices}"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Devices_Click">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDevicesGeometry}"
                                  Style="{StaticResource NavigationIconPathStyle}"
                                  Margin="0,0,12,0"/>
                            <TextBlock x:Name="DevicesNavLabel"
                                       Text="{DynamicResource Nav_Devices}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="IpConflictsNavButton"
                            AutomationProperties.Name="{DynamicResource Nav_IpConflicts}"
                            ToolTip="{DynamicResource Tooltip_IpConflicts}"
                            Style="{StaticResource NavButtonStyle}"
                            Click="IpConflicts_Click">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Path Data="{StaticResource IconWarningGeometry}"
                                  Style="{StaticResource NavigationIconPathStyle}"
                                  Margin="0,0,12,0"/>
                            <TextBlock x:Name="IpConflictsNavLabel"
                                       Text="{DynamicResource Nav_IpConflicts}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="IpRecoveryNavButton"
                            AutomationProperties.Name="{DynamicResource Nav_IpRecovery}"
                            ToolTip="{DynamicResource Tooltip_IpRecovery}"
                            Style="{StaticResource NavButtonStyle}"
                            Click="IpRecovery_Click">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRecoveryGeometry}"
                                  Style="{StaticResource NavigationIconPathStyle}"
                                  Margin="0,0,12,0"/>
                            <TextBlock x:Name="IpRecoveryNavLabel"
                                       Text="{DynamicResource Nav_IpRecovery}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiagnosticsNavButton"
                            AutomationProperties.Name="{DynamicResource Nav_Diagnostics}"
                            ToolTip="{DynamicResource Tooltip_Diagnostics}"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Diagnostics_Click">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDiagnosticsGeometry}"
                                  Style="{StaticResource NavigationIconPathStyle}"
                                  Margin="0,0,12,0"/>
                            <TextBlock x:Name="DiagnosticsNavLabel"
                                       Text="{DynamicResource Nav_Diagnostics}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="SettingsNavButton"
                            AutomationProperties.Name="{DynamicResource Nav_Settings}"
                            ToolTip="{DynamicResource Tooltip_Settings}"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Settings_Click">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSettingsGeometry}"
                                  Style="{StaticResource NavigationIconPathStyle}"
                                  Margin="0,0,12,0"/>
                            <TextBlock x:Name="SettingsNavLabel"
                                       Text="{DynamicResource Nav_Settings}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="LocalInventoryCard"
                            Background="{DynamicResource SurfaceGlassBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="12"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Shell_LocalInventoryTitle}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="Bold"
                                       FontSize="10"/>
                            <TextBlock Text="{DynamicResource Shell_LocalInventorySaved}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1"
              Background="{DynamicResource ContentAreaBrush}"
              ClipToBounds="True">
            <!-- Application shell: fixed header, flexible page viewport, fixed footer. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <!-- Header: fixed -->
                <RowDefinition Height="*"/>
                <!-- Main content: consumes remaining space -->
                <RowDefinition Height="36"/>
                <!-- Footer: fixed -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceGlassBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1">
                <Grid x:Name="HeaderContentGrid"
                      Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="{DynamicResource Nav_Dashboard}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Shell_ItNetworkOperations}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="ThemeToggleButton"
                                AutomationProperties.Name="{DynamicResource Tooltip_ToggleTheme}"
                                Style="{StaticResource QuietButtonStyle}"
                                Height="38"
                                Margin="0,0,10,0"
                                Click="ThemeToggle_Click"
                                ToolTip="{DynamicResource Tooltip_Theme}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Path Data="{StaticResource IconThemeGeometry}"
                                      Style="{StaticResource ToolbarIconPathStyle}"
                                      Margin="0,0,8,0"/>
                                <TextBlock x:Name="ThemeToggleText"
                                           Text="{DynamicResource Theme_SwitchToDark}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="11,7"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{DynamicResource PrimaryBrush}"
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Shell_LocalInventory}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The page host fills the complete middle row. Page-level padding is owned by each view,
                 so the main scrollbar can sit at the far edge of this viewport. -->
            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ClipToBounds="True"/>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceGlassBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <DockPanel x:Name="FooterContentPanel"
                           Margin="24,0">
                    <TextBlock x:Name="FooterVersionText"
                               Text="{DynamicResource Footer_Brand}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterStatusText"
                               Text="{DynamicResource Shell_FooterStatus}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
