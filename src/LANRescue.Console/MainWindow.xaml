<Window x:Class="LANRescue.ConsoleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN Rescue"
        Height="860"
        Width="1440"
        MinHeight="700"
        MinWidth="1120"
        WindowState="Maximized"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="20,22">
                <StackPanel DockPanel.Dock="Top"
                            Margin="5,0,5,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="{DynamicResource PrimaryButtonBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="⌁"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-3,0,0"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="LAN RESCUE"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock Text="NETWORK OPERATIONS"
                                       Foreground="{DynamicResource SidebarMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1"
                            Background="{DynamicResource BorderBrushSoft}"
                            Margin="0,20,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WORKSPACE"
                               Foreground="{DynamicResource SidebarMutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="10,0,0,8"/>
                    <Button x:Name="DashboardNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Content="⌂   Dashboard"
                            Click="Dashboard_Click"/>
                    <Button x:Name="DevicesNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Content="▤   Devices"
                            Click="Devices_Click"/>
                    <Button x:Name="IpConflictsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Content="⚠   IP Conflicts"
                            Click="IpConflicts_Click"/>
                    <Button x:Name="IpRecoveryNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Content="⇄   IP Recovery"
                            Click="IpRecovery_Click"/>
                    <Button x:Name="DiagnosticsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Content="⌕   Diagnostics"
                            Click="Diagnostics_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="SettingsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Content="⚙   Settings"
                            Click="Settings_Click"/>
                    <Border Background="{DynamicResource SurfaceGlassBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="12"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="LOCAL INVENTORY"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="Bold"
                                       FontSize="10"/>
                            <TextBlock Text="SQLite · Saved on this PC"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1"
              Background="{DynamicResource ContentAreaBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceGlassBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="Dashboard"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="IT NETWORK OPERATIONS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="ThemeToggleButton"
                                Content="◐  Theme"
                                Style="{StaticResource QuietButtonStyle}"
                                Height="38"
                                Margin="0,0,10,0"
                                Click="ThemeToggle_Click"
                                ToolTip="Switch Light / Dark theme"/>
                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="11,7"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{DynamicResource PrimaryBrush}"
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Local inventory"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            Margin="24,20"/>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceGlassBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="24,0">
                    <TextBlock Text="LAN Rescue v0.4.1 · Fresh Fluent"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Local inventory only · Network operations are disabled"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
