<UserControl x:Class="LANRescue.ConsoleApp.Views.IpConflictView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Foreground="{DynamicResource TextPrimaryBrush}"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LANRescue.ConsoleApp.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="IP conflicts" Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock Text="Illustrative conflict records. The ARP cache alone cannot identify the intended target."
                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Background="{DynamicResource WarningSurfaceBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Important safety rule" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold"/>
                <TextBlock Text="Do not change an endpoint's IP until its Agent identity is authenticated through a working management channel independent of the conflicting IPv4."
                           Foreground="{DynamicResource WarningTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Conflict group: 192.168.110.93" Style="{StaticResource SectionTitleTextStyle}"/>
                <TextBlock Text="Gateway: 192.168.110.9  |  Subnet: 255.255.255.0"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,12" FontSize="11"/>
                <DataGrid MinHeight="150" MaxHeight="260" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}" Header="Device" Binding="{Binding DeviceName}" Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}" Header="Sample MAC" Binding="{Binding MacAddress}" Width="1.5*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}" Header="Target identity" Binding="{Binding Identity}" Width="1.3*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}" Header="Evidence" Binding="{Binding Evidence}" Width="1.2*"/>
                    </DataGrid.Columns>
                    <DataGrid.Items>
                        <local:ConflictRow DeviceName="QA-PC-02 (B)" MacAddress="BB-BB-BB-BB-BB-BB"
                                           Identity="Not verified" Evidence="Sample record"/>
                        <local:ConflictRow DeviceName="QA-PC-03 (C)" MacAddress="CC-CC-CC-CC-CC-CC"
                                           Identity="Not verified" Evidence="Sample record"/>
                    </DataGrid.Items>
                </DataGrid>
            </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
</UserControl>
