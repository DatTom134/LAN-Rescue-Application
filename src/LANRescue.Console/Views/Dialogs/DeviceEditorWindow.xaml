<Window x:Class="LANRescue.ConsoleApp.Views.Dialogs.DeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LANRescue.ConsoleApp.Controls"
        Title="{DynamicResource DeviceEditor_Title}"
        Width="900"
        Height="820"
        MinWidth="760"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Height="58"
                Margin="0,0,0,18"
                Background="Transparent"
                MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="DialogTitleText"
                               Text="{DynamicResource DeviceEditor_AddDevice}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock
                        Text="{DynamicResource DeviceEditor_Description}"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Close button -->
                <Button Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Click="Cancel_Click"
                        ToolTip="{DynamicResource DeviceEditor_Close}"
                        AutomationProperties.Name="{DynamicResource DeviceEditor_Close}">
                    <Path Data="{StaticResource IconCloseGeometry}"
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="1.6"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>


        <controls:SmoothScrollViewer Grid.Row="1"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Padding="0,0,8,12">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DeviceEditor_Identity}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_DeviceCode}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="DeviceCodeBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_DeviceName}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="DeviceNameBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_DeviceType}"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="DeviceTypeCombo"
                                          Height="38"
                                          Padding="8,6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLocalizationConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_Department}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="DepartmentBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_Manufacturer}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="ManufacturerBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_Model}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="ModelBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,0,0">
                                <TextBlock Text="{DynamicResource DeviceEditor_SerialNumber}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="SerialNumberBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3"
                                        Grid.Column="2">
                                <TextBlock Text="{DynamicResource DeviceEditor_Location}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="LocationBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource DeviceEditor_FirmwareVersion}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="FirmwareVersionBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DeviceEditor_NetworkInterface}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_InterfaceName}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="InterfaceNameBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_MacAddress}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="MacAddressBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_Ipv4Address}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="Ipv4Box"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource DeviceEditor_PrefixLength}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="PrefixLengthBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2"
                                        Grid.Column="0">
                                <TextBlock Text="{DynamicResource DeviceEditor_AddressAssignment}"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="AssignmentModeCombo"
                                          Height="38"
                                          Padding="8,6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLocalizationConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="2"
                                        Grid.Column="2">
                                <TextBlock Text="{DynamicResource DeviceEditor_DefaultGateway}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="GatewayBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource DeviceEditor_DnsServers}"
                                   Margin="0,12,0,5"/>
                        <TextBox x:Name="DnsServersBox"
                                 Height="38"
                                 Padding="10,4"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PrinterDetailsPanel"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DeviceEditor_PrinterDetails}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource DeviceEditor_DriverName}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="PrinterDriverBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource DeviceEditor_PortName}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="PrinterPortBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource DeviceEditor_PrintServer}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="PrintServerBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource DeviceEditor_ShareName}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="ShareNameBox"
                                         Height="38"
                                         Padding="10,4"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="14"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DeviceEditor_Notes}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <TextBox x:Name="NotesBox"
                                 MinHeight="74"
                                 Padding="8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:SmoothScrollViewer>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource DeviceEditor_RequiredFields}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"/>

                    <TextBlock x:Name="ValidationMessageText"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,12,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Content="{DynamicResource DeviceEditor_Cancel}"
                            Width="96"
                            Height="38"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="Cancel_Click"
                            FontSize="13"/>
                    <Button Content="{DynamicResource DeviceEditor_Save}"
                            Width="120"
                            Height="38"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                            Click="Save_Click"
                            IsDefault="True"
                            FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
