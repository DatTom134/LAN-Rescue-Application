<UserControl x:Class="LANRescue.ConsoleApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             Foreground="{DynamicResource TextPrimaryBrush}"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LANRescue.ConsoleApp.Controls">
    <controls:SmoothScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <Border Style="{StaticResource PageContentContainerStyle}">
            <StackPanel>
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{DynamicResource Settings_Title}"
                               Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock Text="{DynamicResource Settings_Description}"
                               Style="{StaticResource PageSubtitleTextStyle}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource GlassCardBorderStyle}"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_Appearance}"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="{DynamicResource Settings_AppearanceDescription}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,6,18,0"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeSelector"
                                  Grid.Column="1"
                                  Height="38"
                                  VerticalAlignment="Center"
                                  SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Settings_LightTheme}"
                                          Tag="Light"/>
                            <ComboBoxItem Content="{DynamicResource Settings_DarkTheme}"
                                          Tag="Dark"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource GlassCardBorderStyle}"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                Text="{DynamicResource Settings_Language}"
                                Style="{StaticResource SectionTitleTextStyle}"/>

                            <TextBlock
                                Text="{DynamicResource Settings_LanguageDescription}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Margin="0,6,18,0"/>
                        </StackPanel>

                        <ComboBox
                            x:Name="LanguageSelector"
                            Grid.Column="1"
                            Height="38"
                            VerticalAlignment="Center"
                            SelectedValuePath="Tag"
                            SelectionChanged="LanguageSelector_SelectionChanged">

                            <ComboBoxItem Tag="Vietnamese">
                                <TextBlock
                                    Text="{DynamicResource Language_Vietnamese}"/>
                            </ComboBoxItem>

                            <ComboBoxItem Tag="English">
                                <TextBlock
                                    Text="{DynamicResource Language_English}"/>
                            </ComboBoxItem>

                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource GlassCardBorderStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_MotionAccessibility}"
                                   Style="{StaticResource SectionTitleTextStyle}"/>
                        <CheckBox x:Name="ReducedMotionCheckBox"
                                  Content="{DynamicResource Settings_ReduceAnimations}"
                                  Margin="0,12,0,4"
                                  Checked="ReducedMotionCheckBox_Changed"
                                  Unchecked="ReducedMotionCheckBox_Changed"/>
                        <TextBlock Text="{DynamicResource Settings_ReducedMotionDescription}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_WindowEffects}"
                                   Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{DynamicResource Settings_WindowEffectsDescription}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="{DynamicResource Settings_WindowEffectsFallback}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Application}"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Settings_Product}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource App_Name}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1"
                                       Text="{DynamicResource Settings_Version}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{DynamicResource Settings_Unknown}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2"
                                       Text="{DynamicResource Settings_Framework}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text=".NET 10 / WPF"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3"
                                       Text="{DynamicResource Settings_Storage}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{DynamicResource Settings_StorageDescription}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4"
                                       Text="{DynamicResource Settings_DatabasePath}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,5,0,0"/>
                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Text="%LOCALAPPDATA%\LANRescue\data\lanrescue.db"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,5,0,5"/>
                            <TextBlock Grid.Row="5"
                                       Text="{DynamicResource Settings_NetworkOperations}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       Text="{DynamicResource Settings_DisabledPreview}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </controls:SmoothScrollViewer>
</UserControl>
