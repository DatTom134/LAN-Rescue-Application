<UserControl x:Class="LANRescue.ConsoleApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             Foreground="{DynamicResource TextPrimaryBrush}"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LANRescue.ConsoleApp.Controls">
    <controls:SmoothScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <Border Style="{StaticResource PageContentContainerStyle}">
            <StackPanel>
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Settings"
                               Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock Text="Personalize the workspace and review application information."
                               Style="{StaticResource PageSubtitleTextStyle}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource GlassCardBorderStyle}"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Appearance"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Choose the color scheme used throughout LAN Rescue. The selection is saved for this Windows user."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,6,18,0"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeSelector"
                                  Grid.Column="1"
                                  Height="38"
                                  VerticalAlignment="Center"
                                  SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="Light theme"
                                          Tag="Light"/>
                            <ComboBoxItem Content="Dark theme"
                                          Tag="Dark"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource GlassCardBorderStyle}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Motion &amp; accessibility"
                                   Style="{StaticResource SectionTitleTextStyle}"/>
                        <CheckBox x:Name="ReducedMotionCheckBox"
                                  Content="Reduce non-essential animations"
                                  Margin="0,12,0,4"
                                  Checked="ReducedMotionCheckBox_Changed"
                                  Unchecked="ReducedMotionCheckBox_Changed"/>
                        <TextBlock Text="Disables page and inspector transitions and smooth scrolling. Loading indicators remain visible as static progress feedback. This preference is saved for this Windows user."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Window effects"
                                   Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="On supported Windows 11 versions, LAN Rescue requests the native Mica backdrop and rounded window corners. Popup menus use translucent surfaces and fade transitions."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="When these effects are unavailable, the application falls back to regular WPF surfaces and remains fully usable."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Application"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Product"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="LAN Rescue"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1"
                                       Text="Version"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Text="Unknown"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2"
                                       Text="Framework"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text=".NET 10 / WPF"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3"
                                       Text="Storage"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="SQLite · Local device inventory"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4"
                                       Text="Database path"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,5,0,0"/>
                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Text="%LOCALAPPDATA%\LANRescue\data\lanrescue.db"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,5,0,5"/>
                            <TextBlock Grid.Row="5"
                                       Text="Network operations"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       Text="Disabled in this preview"
                                       Foreground="{DynamicResource WarningBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </controls:SmoothScrollViewer>
</UserControl>
