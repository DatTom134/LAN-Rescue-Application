<UserControl x:Class="LANRescue.ConsoleApp.Views.IpRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Foreground="{DynamicResource TextPrimaryBrush}"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LANRescue.ConsoleApp.Controls">
    <controls:SmoothScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <Border Style="{StaticResource PageContentContainerStyle}">
            <StackPanel>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="IP recovery" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Design preview for a controlled remote IP change workflow."
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Demo mode — actions are disabled" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold"/>
                    <TextBlock Text="This screen will not change any real network configuration. A future version must authenticate the target Agent and verify the new IP allocation first."
                               Foreground="{DynamicResource WarningTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </Border>

            <Grid x:Name="RecoveryCardsGrid" SizeChanged="RecoveryCardsGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
            <Border x:Name="RecoveryTargetCard" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Target device" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Device" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="QA-PC-02 · QA-PC-002" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Current IPv4" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="192.168.110.93" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Text="Management channel" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Not connected — sample only" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="RecoveryConfigCard" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="2. New network configuration" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,14"/>
                    <TextBlock Text="Address mode" Margin="0,0,0,5" FontSize="11"/>
                    <ComboBox x:Name="AddressModeBox" SelectedIndex="0" Width="240" HorizontalAlignment="Left"
                              IsEnabled="False" Margin="0,0,0,14">
                        <ComboBoxItem Content="Static IPv4 (sample)"/>
                        <ComboBoxItem Content="DHCP (future)"/>
                    </ComboBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="IPv4 address" Margin="0,0,0,5" FontSize="11"/>
                            <TextBox Text="192.168.110.152" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Subnet mask" Margin="0,0,0,5" FontSize="11"/>
                            <TextBox Text="255.255.255.0" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Default gateway" Margin="0,0,0,5" FontSize="11"/>
                            <TextBox Text="192.168.110.9" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="DNS server" Margin="0,0,0,5" FontSize="11"/>
                            <TextBox Text="Company DNS (not specified)" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="192.168.110.152 is an example only. Do not assign it without approval and an IPAM/DHCP check."
                               Foreground="{DynamicResource WarningBrush}" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </Border>
            </Grid>
            <Button Content="Apply new IP — Disabled in preview" IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </controls:SmoothScrollViewer>
</UserControl>
