<UserControl x:Class="LANRescue.ConsoleApp.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             Foreground="{DynamicResource TextPrimaryBrush}"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LANRescue.ConsoleApp.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Style="{StaticResource PageContentContainerStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Devices_Title}"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="{DynamicResource Devices_Description}"
                           Style="{StaticResource PageSubtitleTextStyle}"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <WrapPanel Grid.Row="1"
                       Margin="0,0,0,14"
                       VerticalAlignment="Center">
                <TextBox x:Name="SearchBox"
                         Width="220"
                         Height="38"
                         Margin="0,0,8,8"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="{DynamicResource Devices_SearchHint}"/>
                <ComboBox x:Name="FilterComboBox"
                          Width="144"
                          Height="38"
                          Margin="0,0,12,8"
                          SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource Devices_All}"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource Devices_ManagedOnly}"/>
                    <ComboBoxItem Content="{DynamicResource Devices_NotManaged}"/>
                </ComboBox>
                <TextBlock x:Name="RecordCountText"
                           Text="{DynamicResource Devices_LoadingCatalog}"
                           Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="11"/>
                <Button x:Name="NewDeviceButton"
                        Height="38"
                        Margin="0,0,8,8"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="NewDevice_Click">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPlusGeometry}"
                              Stroke="{DynamicResource PrimaryButtonForegroundBrush}"
                              StrokeThickness="1.6"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Devices_NewDevice}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="EditDeviceButton"
                        Content="{DynamicResource Devices_Edit}"
                        Height="38"
                        Margin="0,0,8,8"
                        IsEnabled="False"
                        Click="EditDevice_Click"/>
                <Button x:Name="StopManagingButton"
                        Content="{DynamicResource Devices_StopManaging}"
                        Height="38"
                        Margin="0,0,8,8"
                        Style="{StaticResource DangerButtonStyle}"
                        IsEnabled="False"
                        Click="StopManaging_Click"/>
                <Button x:Name="ReactivateButton"
                        Content="{DynamicResource Devices_Reactivate}"
                        Height="38"
                        Margin="0,0,0,8"
                        IsEnabled="False"
                        Click="Reactivate_Click"/>
            </WrapPanel>

            <Grid x:Name="DevicesLayoutGrid"
                  Grid.Row="2"
                  SizeChanged="DevicesLayoutGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"
                                      MinWidth="260"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="300"
                                      MinWidth="260"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <Border x:Name="DevicesTableCard"
                        Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="8">
                    <DataGrid x:Name="DevicesGrid"
                              SelectionChanged="DevicesGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              PreviewMouseRightButtonDown="DevicesGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Devices_CopyDeviceCode}"
                                          Click="CopyDeviceCode_Click"/>
                                <MenuItem Header="{DynamicResource Devices_CopyIPv4}"
                                          Click="CopyIpv4_Click"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Devices_EditDevice}"
                                          Click="EditDevice_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}"
                                                Header="{DynamicResource Devices_ColumnCode}"
                                                Binding="{Binding DeviceCode}"
                                                Width="1.05*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}"
                                                Header="{DynamicResource Devices_ColumnName}"
                                                Binding="{Binding DeviceName}"
                                                Width="1.15*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}"
                                                Header="{DynamicResource Devices_ColumnType}"
                                                Binding="{Binding DeviceType}"
                                                Width="0.72*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}"
                                                Header="{DynamicResource Devices_ColumnIPv4}"
                                                Binding="{Binding IPv4}"
                                                Width="1.05*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}"
                                                Header="{DynamicResource Devices_ColumnLocation}"
                                                Binding="{Binding Location}"
                                                Width="1.1*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}"
                                                Header="{DynamicResource Devices_ColumnNetwork}"
                                                Binding="{Binding Reachability}"
                                                Width="0.8*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DataGridTextBlockStyle}"
                                                Header="{DynamicResource Devices_ColumnManagement}"
                                                Binding="{Binding ManagementStatus}"
                                                Width="1.0*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border x:Name="DetailsPanel"
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource GlassElevatedCardBorderStyle}"
                        Padding="0"
                        ClipToBounds="True">
                    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto"
                                                 Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                       Text="{DynamicResource Devices_Inspector}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding DeviceName}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DeviceCode}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,3,0,8"/>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="8"
                                    Padding="9"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                               Text="{DynamicResource Devices_NetworkStatus}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,0,5"/>
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="Reachability"/>
                                                <Binding Path="IpStatus"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource Devices_ColumnIPv4}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               Margin="0,8,0,1"/>
                                    <TextBlock Text="{Binding IPv4}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding IpAssignment}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                       Text="{DynamicResource Devices_DeviceInformation}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,0,0,7"/>
                            <TextBlock Text="{DynamicResource Devices_TypeDepartment}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Margin="0,1,0,7"
                                       FontSize="11">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="DeviceType"/>
                                        <Binding Path="Department"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Devices_ManufacturerModel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding Hardware}"
                                       FontSize="11"
                                       Margin="0,1,0,7"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{DynamicResource Devices_SerialNumber}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding SerialNumber}"
                                       FontSize="11"
                                       Margin="0,1,0,7"/>
                            <TextBlock Text="{DynamicResource Devices_OperatingSystem}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding OperatingSystem}"
                                       FontSize="11"
                                       Margin="0,1,0,7"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Devices_Location}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding Location}"
                                       FontSize="11"
                                       Margin="0,1,0,12"
                                       TextWrapping="Wrap"/>

                            <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                       Text="{DynamicResource Devices_NetworkInterface}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,0,0,7"/>
                            <TextBlock Text="{DynamicResource Devices_InterfaceLink}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Margin="0,1,0,7"
                                       FontSize="11">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="NetworkInterfaceName"/>
                                        <Binding Path="LinkStatus"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Devices_MacAddress}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding MacAddress}"
                                       FontSize="11"
                                       Margin="0,1,0,7"/>
                            <TextBlock Text="{DynamicResource Devices_DefaultGateway}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding Gateway}"
                                       FontSize="11"
                                       Margin="0,1,0,7"/>
                            <TextBlock Text="{DynamicResource Devices_DnsServers}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding DnsServers}"
                                       FontSize="11"
                                       Margin="0,1,0,7"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Devices_AllInterfaces}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding AllNetworkInterfaces}"
                                       FontSize="11"
                                       Margin="0,1,0,12"
                                       TextWrapping="Wrap"/>

                            <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                       Text="{DynamicResource Devices_ManagementChannel}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,0,0,7"/>
                            <TextBlock Text="{DynamicResource Devices_ManagementPath}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding ManagementChannels}"
                                       FontSize="11"
                                       Margin="0,1,0,7"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Devices_AgentId}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding AgentId}"
                                       FontSize="11"
                                       Margin="0,1,0,7"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Devices_AgentStatusVersion}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock FontSize="11"
                                       Margin="0,1,0,7">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="AgentStatus"/>
                                        <Binding Path="AgentVersion"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Devices_LastHeartbeat}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding LastHeartbeat}"
                                       FontSize="11"
                                       Margin="0,1,0,7"/>
                            <TextBlock Text="{DynamicResource Devices_SpecificDetails}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"/>
                            <TextBlock Text="{Binding DeviceSpecificDetails}"
                                       FontSize="10"
                                       Margin="0,1,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </controls:SmoothScrollViewer>
                </Border>
                <Border x:Name="CatalogLoadingState"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Panel.ZIndex="20"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Visible">
                    <StackPanel Width="260"
                                HorizontalAlignment="Center">
                        <ProgressBar x:Name="CatalogLoadingProgressBar"
                                     IsIndeterminate="True"
                                     Height="4"
                                     Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Devices_LoadingInventory}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Devices_ReadingCatalog}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CatalogEmptyState"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Panel.ZIndex="15"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel Width="280"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Devices_NoMatch}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Devices_ClearSearchDescription}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Margin="0,5,0,12"/>
                        <Button Content="{DynamicResource Devices_ClearFilters}"
                                Click="ClearDeviceFilters_Click"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CatalogErrorState"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Panel.ZIndex="25"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel Width="340"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Devices_CatalogUnavailable}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="CatalogErrorMessage"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,6,0,12"/>
                        <Button Content="{DynamicResource Devices_Retry}"
                                Click="RetryCatalog_Click"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
