<Application x:Class="LANRescue.ConsoleApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LANRescue.ConsoleApp.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                    Source="Resources/Colors.Light.xaml"/>

                <ResourceDictionary
                    Source="Resources/Controls.xaml"/>

                <!-- Default language: English -->
                <ResourceDictionary
                    Source="Resources/Strings.en.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <converters:EnumLocalizationConverter
                x:Key="EnumLocalizationConverter"/>
            <converters:DiagnosticEvidenceDetailsConverter
                x:Key="DiagnosticEvidenceDetailsConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
